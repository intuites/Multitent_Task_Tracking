# Copy to .env.local and fill in. Never put real values in this file: it is committed.
# Safe for browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only (never prefix with VITE_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
APP_URL=http://localhost:5173
# Sender shown on every task email. Quote the name when it has parentheses.
EMAIL_FROM="Intuites (Operations Management)" <operations@intuites.com>
# SMTP, used first when SMTP_PASS is set. Gmail: SMTP_USER is the EMAIL_FROM mailbox, SMTP_PASS an App Password
# (Google Account > Security > 2-Step Verification on > App passwords). Host and port default to smtp.gmail.com:465.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
# Gmail API, used when SMTP_PASS is empty (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type Web application).
# The refresh token is for the EMAIL_FROM mailbox, with the scope https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Only used when GOOGLE_REFRESH_TOKEN is empty: Resend API key
EMAIL_PROVIDER_API_KEY=
